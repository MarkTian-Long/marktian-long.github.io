{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qiuzhi.local/schemas/portfolio-evidence.schema.json",
  "title": "Qiuzhi Portfolio Evidence",
  "type": "object",
  "required": ["schemaVersion", "portfolio"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "portfolio": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "datedEvidence": {
      "type": "object",
      "required": ["kind", "description", "source", "asOf"],
      "properties": {
        "kind": { "enum": ["artifact", "evaluation", "research", "case-note"] },
        "description": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "asOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      },
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "required": ["kind", "definition", "source", "asOf"],
      "properties": {
        "kind": {
          "enum": ["target", "proxy", "offline-measured", "production-result", "external-research"]
        },
        "definition": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "asOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      },
      "additionalProperties": false
    },
    "links": {
      "type": "object",
      "required": ["demo", "case", "code", "article"],
      "properties": {
        "demo": { "type": ["string", "null"] },
        "case": { "type": ["string", "null"] },
        "code": { "type": ["string", "null"] },
        "article": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": [
        "id", "title", "tier", "type", "status", "myRole", "realParts", "mockParts",
        "mockBoundary", "metrics", "evidence", "limitations", "links", "lastVerified"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "tier": { "enum": ["flagship", "supporting", "concept"] },
        "type": { "enum": ["interactive-demo", "case-study", "research-system"] },
        "status": { "enum": ["published", "private", "in-progress"] },
        "myRole": { "type": "string", "minLength": 1 },
        "realParts": { "type": "array", "items": { "type": "string" } },
        "mockParts": { "type": "array", "items": { "type": "string" } },
        "mockBoundary": { "type": "string", "minLength": 1 },
        "metrics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/metric" } },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/datedEvidence" } },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "links": { "$ref": "#/$defs/links" },
        "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      },
      "additionalProperties": false
    }
  }
}
